# BenchLab Telemetry Server Configuration
# Copy this file to .env and modify as needed

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Telemetry Configuration
POLL_INTERVAL=1.0          # Seconds between sensor reads (minimum 0.1)
HISTORY_LENGTH=10          # Number of historical readings to keep per device
MAX_HISTORY_LIMIT=1000     # Maximum history limit for API requests
SCAN_INTERVAL=10           # Seconds between device discovery scans

# Performance Tuning
# Lower values = more frequent updates but higher CPU usage
# Higher values = less frequent updates but lower CPU usage